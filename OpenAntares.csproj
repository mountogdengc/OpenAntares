<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenAntares.Game</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The simulation library and tests are separate projects; don't compile them twice. -->
    <Compile Remove="src/**" />
    <Compile Remove="tests/**" />
    <!-- Standalone evidence tools (and their generated obj files) are never game code. -->
    <Compile Remove="tools/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/OpenAntares.Simulation/OpenAntares.Simulation.csproj" />
  </ItemGroup>
</Project>
